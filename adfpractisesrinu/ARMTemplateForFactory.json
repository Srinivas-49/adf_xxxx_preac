									"type": "Query",
									"text": {
										"value": "select count(*) as total_records from @{pipeline().parameters.schema}.@{pipeline().parameters.table} where last_updated > '@{if(empty(pipeline().parameters.back_date),activity('look_up_json').output.value[0].cdc_timestamp,pipeline().parameters.back_date)}'",
